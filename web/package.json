{
  "name": "tian-ming-local-web",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный веб-MVP BaZi + Zi Wei",
  "scripts": {
    "build": "npm --prefix ../calculator run build && node scripts/build.cjs",
    "test": "npm --prefix ../calculator test && node --require ./tests/test-environment.cjs --test tests/*.test.cjs",
    "dev": "npm run build && node server.cjs",
    "start": "node server.cjs",
    "places:import": "node scripts/import-geonames.cjs",
    "pdf:saved": "node scripts/generate-saved-report-pdf.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "city-timezones": "^1.3.4",
    "dotenv": "^17.2.3",
    "openai": "^6.16.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "timezonecomplete": "^5.15.1"
  }
}
