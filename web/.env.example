# Скопируйте этот файл в web/.env и вставьте ключ после знака =
OPENAI_API_KEY=

# Модель можно не менять. Она выбрана как баланс качества и стоимости.
OPENAI_MODEL=gpt-5.6-terra

# Для локальной демонстрации без API: AI_MODE=mock
AI_MODE=

# В development полный отчёт открыт. false оставляет только бесплатное preview.
HAS_FULL_REPORT=true

# Production payments. Values belong only in Railway Variables, never in Git.
PAYMENT_MODE=
PREMIUM_REPORT_PRICE_RUB=
DATABASE_URL=
PUBLIC_BASE_URL=
LORENTSEN_API_BASE_URL=
LORENTSEN_API_TOKEN=
LORENTSEN_WEBHOOK_ENDPOINT_ID=
LORENTSEN_WEBHOOK_SECRET=
LORENTSEN_WEBHOOK_SIGNING_KEY_VERSION=
LORENTSEN_CONSENT_VERSION=
LORENTSEN_AUTO_REDEMPTION_CONSENT_VERSION=
LORENTSEN_PARTNER_PUBLIC_NAME=
LORENTSEN_TERMS_URL=
LORENTSEN_PRIVACY_URL=
LORENTSEN_AUTO_REDEMPTION_TERMS_URL=
LORENTSEN_REQUEST_TIMEOUT_MS=
